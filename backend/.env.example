# Copy this file to .env and replace every placeholder before production.
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=https://erasmus.example.edu
WEB_APP_URL=https://erasmus.example.edu

# Optional upload and email/security settings
ENABLE_IMAGE_COMPRESSION=true
CLAMAV_PATH=
CLAMAV_TIMEOUT=20
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=60
